{
  "expo": {
    "name": "AgroTrack",
    "slug": "tractor-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tractorapp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.agrotrack.app"
    },
    "android": {
      "package": "in.agrotrack.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#002C5C",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#002C5C"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/ChakraPetch-Bold.ttf"
          ]
        }
      ],
      "expo-image",
      [
        "expo-status-bar",
        {
          "style": "dark"
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AgroTrack uses your location to show tractors that can reach your farm, local weather and job distances."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AgroTrack needs your photos to add pictures of products, tractors, crop issues and your profile.",
          "cameraPermission": "AgroTrack uses the camera to take your profile photo.",
          "microphonePermission": false
        }
      ],
      "./plugins/withUpiApps",
      "./plugins/withReleaseSigning"
    ],
    "extra": {
      "apiBaseUrl": "https://tractor.skillinnovex.in/api"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
